FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FalkorDB Cloud: set credentials (the Free tier has no TLS, so leave FALKORDB_TLS=false).
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false
TENANT=nimbuspay

# LLM is optional; deterministic mode is the default and always the fallback.
# Any OpenAI-compatible endpoint works (Gemini, Groq, OpenRouter, Ollama, ...).
LLM_PROVIDER=none
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# Comma-separated; the gateway rotates to the next key on 429.
LLM_API_KEYS=
